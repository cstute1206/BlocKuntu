{
  "manifest_version": 3,
  "name": "BlocKuntu",
  "version": "0.2.3",
  "description": "System-enforced focus blocking for Linux through the local BlocKuntu daemon.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{a7c3f3c4-6b1e-4c6f-9f2a-8d4e5b7c1a90}",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["nativeMessaging", "storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["dist/background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "dist/blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
