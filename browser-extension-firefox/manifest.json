{
  "manifest_version": 3,
  "name": "BlocKuntu",
  "version": "0.2.0",
  "description": "System-enforced focus blocking for Linux through the local BlocKuntu daemon.",
  "browser_specific_settings": {
    "gecko": {
      "id": "blockuntu@example.local",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      },
      "strict_min_version": "140.0"
    }
  },
  "permissions": ["nativeMessaging", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["dist/background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
