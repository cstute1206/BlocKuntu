{
  "name": "blockuntu-chrome-extension",
  "version": "0.2.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "node scripts/check-manifest.mjs",
    "verify": "npm run clean && npm run build && npm run check",
    "package:zip": "npm run verify && node scripts/package-zip.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
