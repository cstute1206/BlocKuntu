{
  "manifest_version": 3,
  "name": "BlocKuntu",
  "version": "0.2.1",
  "description": "System-enforced focus blocking for Linux through the local BlocKuntu daemon.",
  "key": "",
  "permissions": ["alarms", "nativeMessaging", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "dist/blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
