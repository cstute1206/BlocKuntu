{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlocKuntu",
  "version": "0.1.0",
  "identifier": "local.blockuntu.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "BlocKuntu",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Linux focus blocker frontend",
    "longDescription": "BlocKuntu desktop frontend for managing and monitoring the local BlocKuntu daemon."
  }
}
